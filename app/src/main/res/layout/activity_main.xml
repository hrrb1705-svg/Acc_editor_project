<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/cursorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="18sp" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.hrrb.acceditor.CursorEditText
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:textDirection="firstStrong"
            android:textSize="20sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPaste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSelToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPrevWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPrevChar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNextChar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNextWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
